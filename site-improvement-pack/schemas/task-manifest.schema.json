{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site improvement task manifest",
  "type": "object",
  "required": [
    "programme",
    "snapshot_date",
    "execution_policy",
    "tasks"
  ],
  "properties": {
    "programme": {
      "type": "string"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "execution_policy": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "order",
          "title",
          "priority",
          "dependencies",
          "file",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[BT][0-9]{2}$"
          },
          "phase": {
            "enum": [
              "Brand",
              "Technical"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "impact": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "effort": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[BT][0-9]{2}$"
            },
            "uniqueItems": true
          },
          "owner_gate": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "primary_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "blocked",
              "partially_complete",
              "complete"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
